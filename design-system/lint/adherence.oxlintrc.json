{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/auth/**",
              "components/core/**",
              "components/domain/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/painel/**",
              "ui_kits/recepcao/**",
              "ui_kits/shared/**",
              "ui_kits/terminal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|live|size|children|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, live, size, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|positive|danger|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'positive' | 'danger' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Badge> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|success|dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'success' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|month|selected|onSelect|marks|compact|style|key|ref|className|style|children)$/]",
        "message": "<CalendarCard> doesn't accept that prop. Declared props: year, month, selected, onSelect, marks, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CashLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|expected|counted|key|ref|className|style|children)$/]",
        "message": "<CashLine> doesn't accept that prop. Declared props: label, expected, counted."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckoutItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|pro|price|key|ref|className|style|children)$/]",
        "message": "<CheckoutItem> doesn't accept that prop. Declared props: name, pro, price."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|lift|radius|tone|glow|padding|title|subtitle|action|children|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: as, lift, radius, tone, glow, padding, title, subtitle, action, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:lg|xl)$/]",
        "message": "<GlassCard> radius must be one of 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|strong|accent)$/]",
        "message": "<GlassCard> tone must be one of 'default' | 'strong' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|badgeTone|children|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: id, label, icon, badge, badgeTone, children, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:accent|danger)$/]",
        "message": "<SidebarItem> badgeTone must be one of 'accent' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|prefix|variant|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, prefix, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|labels|height|highlight|format|showGrid|key|ref|className|style|children)$/]",
        "message": "<LineChart> doesn't accept that prop. Declared props: data, labels, height, highlight, format, showGrid."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoginSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:photoSrc|logoSrc|defaultMode|onLogin|onSignup|onForgot|width|height|style|key|ref|className|style|children)$/]",
        "message": "<LoginSlider> doesn't accept that prop. Declared props: photoSrc, logoSrc, defaultMode, onLogin, onSignup, onForgot, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoginSlider'] > JSXAttribute[name.name='defaultMode'] > Literal[value!=/^(?:login|signup)$/]",
        "message": "<LoginSlider> defaultMode must be one of 'login' | 'signup'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<NavTab> doesn't accept that prop. Declared props: id, label, icon, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='PendingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|title|description|owner|when|value|actionLabel|onAction|resolved|style|key|ref|className|style|children)$/]",
        "message": "<PendingCard> doesn't accept that prop. Declared props: severity, title, description, owner, when, value, actionLabel, onAction, resolved, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PendingCard'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:alta|media|baixa)$/]",
        "message": "<PendingCard> severity must be one of 'alta' | 'media' | 'baixa'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueTicketCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:ticket|client|service|professional|wait|position|status|size|onCall|onSkip|style|key|ref|className|style|children)$/]",
        "message": "<QueueTicketCard> doesn't accept that prop. Declared props: ticket, client, service, professional, wait, position, status, size, onCall, onSkip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueTicketCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:aguardando|chamada|atendimento|ausente)$/]",
        "message": "<QueueTicketCard> status must be one of 'aguardando' | 'chamada' | 'atendimento' | 'ausente'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueTicketCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<QueueTicketCard> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|className|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: variant, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:icon|pill)$/]",
        "message": "<ThemeToggle> variant must be one of 'icon' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ThemeToggle> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|searchPlaceholder|notifications|user|themeToggle|onSearch|children|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, subtitle, searchPlaceholder, notifications, user, themeToggle, onSearch, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|uploadingLabel|doneLabel|accept|onFile|demo|state|progress|duration|variant|size|block|key|ref|className|style|children)$/]",
        "message": "<UploadButton> doesn't accept that prop. Declared props: label, uploadingLabel, doneLabel, accept, onFile, demo, state, progress, duration, variant, size, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|uploading|done)$/]",
        "message": "<UploadButton> state must be one of 'idle' | 'uploading' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|dark)$/]",
        "message": "<UploadButton> variant must be one of 'primary' | 'secondary' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<UploadButton> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      }
    ]
  },
